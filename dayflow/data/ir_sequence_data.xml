<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Dayflow Employee Code -->
        <record id="seq_dayflow_employee_code" model="ir.sequence">
            <field name="name">Dayflow Employee Code Sequence</field>
            <field name="code">dayflow.employee.code</field>
            <field name="prefix">DF</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
