<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dayflow Leave Types Configuration -->
        <!-- 1. Paid Time Off -->
        <record id="dayflow_leave_type_paid" model="ir.config_parameter">
            <field name="key">dayflow.leave.type.paid</field>
            <field name="value">Paid Time Off</field>
        </record>

        <!-- 2. Sick Leave -->
        <record id="dayflow_leave_type_sick" model="ir.config_parameter">
            <field name="key">dayflow.leave.type.sick</field>
            <field name="value">Sick Leave</field>
        </record>

        <!-- 3. Unpaid Leave -->
        <record id="dayflow_leave_type_unpaid" model="ir.config_parameter">
            <field name="key">dayflow.leave.type.unpaid</field>
            <field name="value">Unpaid Leave</field>
        </record>
    </data>
</odoo>
